---
import { Picture } from 'astro:assets';
import { ARTIFACT, pic, ytOut } from '../../lib/env';
import Base from '../../layouts/Base.astro';
import { projects, picks, instagramReel } from '../../data/projects';
import { site } from '../../data/site';
import { STATS_SNAPSHOT_DATE } from '../../data/videos';
import { getVideo, totals } from '../../lib/portfolio';
import { thumb } from '../../lib/thumbs';
import { compact, duration, longDate } from '../../lib/format';

const Play = ARTIFACT ? 'a' : 'button';
type Cat = 'show' | 'podcast' | 'interview' | 'short';
const cats: { id: Cat | 'all'; label: string }[] = [
  { id: 'all', label: 'All' },
  { id: 'show', label: 'Shows' },
  { id: 'podcast', label: 'Podcasts' },
  { id: 'interview', label: 'Interviews' },
  { id: 'short', label: 'Shorts' },
];

const rank = (id: string) => (picks.includes(id) ? picks.indexOf(id) : picks.length);

const items = projects
  .flatMap((p) =>
    p.episodes.map((id) => {
      const v = getVideo(id);
      const label = p.episodeLabels?.[id] ?? p.title;
      const cat: Cat =
        v.kind === 'short' ? 'short' : p.slug === 'seven-dogs-interview' ? 'interview' : label.startsWith('Podcast') ? 'podcast' : 'show';
      return { v, p, label, cat };
    }),
  )
  // Mohanad's picks first, in his order; everything else keeps project order.
  .sort((a, b) => rank(a.v.id) - rank(b.v.id));

const count = (c: Cat | 'all') => (c === 'all' ? items.length + 1 : items.filter((i) => i.cat === c).length + (c === 'short' ? 1 : 0));
---

<Base
  title={`All work — ${site.name}, ${site.role}`}
  description={`Every edit in one list: ${totals.videos} YouTube videos and an Instagram reel, ${compact(totals.views)} public views.`}
>
  <section class="wrap arch">
    <header class="arch__head">
      <p class="label"><span class="volt">Index</span> <span class="dim">·</span> <span class="muted">His picks first</span></p>
      <h1 class="display arch__title">Every edit,<br /><span class="volt">one list.</span></h1>
      <p class="lead muted">
        {totals.videos} YouTube videos and one Instagram reel. {compact(totals.views)} public views as of {longDate(STATS_SNAPSHOT_DATE)}.
      </p>
    </header>

    <div class="filters" role="group" aria-label="Filter by format" data-filters>
      {
        cats.map((c) => (
          <button type="button" class="filter label" data-filter={c.id} aria-pressed={c.id === 'all' ? 'true' : 'false'}>
            {c.label} <span class="filter__n">{count(c.id)}</span>
          </button>
        ))
      }
    </div>
    <p class="visually-hidden" role="status" aria-live="polite" data-filter-status></p>

    <ol role="list" class="grid" data-grid>
      {
        items.map(({ v, p, label, cat }) => (
          <li class="card" data-cat={cat}>
            <Play
              class="card__play"
              {...(ARTIFACT
                ? ytOut(v.id, v.kind)
                : {
                    type: 'button' as const,
                    'data-modal-yt': v.id,
                    'data-modal-orient': v.kind === 'short' ? 'tall' : 'wide',
                    'data-modal-label': `${p.title} · ${label}`,
                    'data-cursor': 'Play',
                  })}
            >
              <span class="visually-hidden">Play {label} ({p.title}) — {compact(v.views)} views</span>
              <span class:list={['card__media', { 'card__media--tall': v.kind === 'short' }]}>
                {v.kind === 'short' ? (
                  <Picture src={thumb(v.id, 'tall')} {...pic([240, 360])} sizes="12rem" alt="" loading="lazy" />
                ) : (
                  <Picture src={thumb(v.id)} {...pic([400, 640])} sizes="(min-width: 1200px) 25vw, (min-width: 700px) 45vw, 100vw" alt="" loading="lazy" />
                )}
                <span class="card__views label" aria-hidden="true">{compact(v.views)}</span>
                <span class="card__dur label" aria-hidden="true">{duration(v.durationSec)}</span>
              </span>
            </Play>
            <div class="card__info">
              <p class="label muted">{p.title}</p>
              <p class="card__label">{label}</p>
              <p class="card__ar" lang="ar" dir="rtl">{v.title}</p>
              <p class="label dim">{longDate(v.published)}</p>
            </div>
          </li>
        ))
      }
      <li class="card" data-cat="short">
        <a class="card__play" href={instagramReel.url} target="_blank" rel="noopener" data-cursor="Open">
          <span class="visually-hidden">Instagram reel for {instagramReel.creator} — opens Instagram</span>
          <span class="card__media card__media--tall">
            <Picture src={thumb(instagramReel.id, 'tall')} {...pic([240, 360])} sizes="12rem" alt="" loading="lazy" />
            <span class="card__views label" aria-hidden="true">Instagram ↗</span>
          </span>
        </a>
        <div class="card__info">
          <p class="label">Instagram</p>
          <p class="card__label">Reel for {instagramReel.creator}</p>
          <p class="label dim">{compact(instagramReel.likes)} likes · {longDate(instagramReel.published)}</p>
        </div>
      </li>
    </ol>
  </section>
</Base>

<script>
  const root = document.querySelector('[data-filters]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-grid] .card'));
  const status = document.querySelector('[data-filter-status]')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  root?.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('[data-filter]');
    if (!btn) return;
    const f = btn.dataset.filter!;
    root.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    const apply = () => {
      let n = 0;
      cards.forEach((c) => {
        const show = f === 'all' || c.dataset.cat === f;
        c.hidden = !show;
        if (show) n++;
      });
      status.textContent = `Showing ${n} ${n === 1 ? 'video' : 'videos'}`;
    };
    const doc = document as Document & { startViewTransition?: (cb: () => void) => void };
    if (doc.startViewTransition && !reduce) doc.startViewTransition(apply);
    else apply();
  });
</script>

<style>
  .arch {
    padding-block: var(--s-7) var(--section);
  }
  .arch__head {
    display: grid;
    gap: var(--s-4);
    margin-bottom: var(--s-7);
  }
  .arch__title {
    font-size: var(--fs-h1);
    font-stretch: 64%;
  }
  .filters {
    position: sticky;
    top: calc(4.25rem + env(safe-area-inset-top, 0px));
    z-index: var(--z-sticky);
    display: flex;
    gap: var(--s-2);
    overflow-x: auto;
    padding-block: var(--s-3);
    margin-bottom: var(--s-6);
    background: rgb(10 10 11 / 0.9);
    backdrop-filter: blur(10px);
    scrollbar-width: none;
  }
  .filter {
    flex: 0 0 auto;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    color: var(--muted);
    transition:
      background-color var(--t-fast),
      color var(--t-fast),
      border-color var(--t-fast);
  }
  .filter:hover {
    color: var(--paper);
    border-color: var(--paper);
  }
  .filter[aria-pressed='true'] {
    background: var(--volt);
    border-color: var(--volt);
    color: var(--volt-ink);
  }
  .filter__n {
    color: var(--dim);
    margin-left: 0.3em;
  }
  .filter[aria-pressed='true'] .filter__n {
    color: inherit;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--s-7) var(--s-5);
  }
  .card {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .card[hidden] {
    display: none;
  }
  .card__play {
    display: block;
    width: 100%;
  }
  .card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink-3);
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-cine) var(--ease-out);
  }
  .card__media--tall :global(img) {
    width: auto;
    height: 100%;
    margin-inline: auto;
    object-fit: contain;
  }
  .card__play:hover .card__media :global(img) {
    transform: scale(1.04);
  }
  .card__views,
  .card__dur {
    position: absolute;
    bottom: var(--s-2);
    padding: 0.2em 0.45em;
    background: rgb(10 10 11 / 0.85);
  }
  .card__views {
    left: var(--s-2);
    color: var(--volt);
  }
  .card__dur {
    right: var(--s-2);
  }
  .card__info {
    display: grid;
    gap: var(--s-1);
  }
  .card__label {
    font-weight: 600;
  }
  .card__ar {
    color: var(--muted);
    font-size: 0.9rem;
    text-align: left;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
