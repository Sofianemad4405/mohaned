---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import YouTubePlayer from '../../components/YouTubePlayer.astro';
import VideoLoop from '../../components/VideoLoop.astro';
import Text from '../../components/Text.astro';
import { projects } from '../../data/projects';
import { getMotion } from '../../data/motion';
import { site } from '../../data/site';
import { getVideo, projectStats } from '../../lib/portfolio';
import { thumb } from '../../lib/thumbs';
import { compact, duration, durationWords, longDate, monthYear } from '../../lib/format';
import { poster } from '../../lib/posters';
import ShortsRail from '../../components/ShortsRail.astro';

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { index: i } }));
}

const { index } = Astro.props as { index: number };
const p = projects[index];
const next = projects[(index + 1) % projects.length];
const s = projectStats(p);
const nextStats = projectStats(next);
const isShorts = s.top.kind === 'short';
const group = `case-${p.slug}`;
const eps = p.episodes.map(getVideo);
const label = (id: string) => p.episodeLabels?.[id] ?? getVideo(id).title;
const period = s.firstDate.slice(0, 7) === s.lastDate.slice(0, 7) ? monthYear(s.firstDate) : `${monthYear(s.firstDate)} – ${monthYear(s.lastDate)}`;
const runtime = s.count === 1 ? durationWords(s.minDuration) : `${durationWords(s.minDuration)} – ${durationWords(s.maxDuration)}`;
const related = (p.related?.motion ?? []).map((m) => getMotion(m)!).filter(Boolean);

const isoDuration = (sec: number) => `PT${Math.floor(sec / 3600)}H${Math.floor((sec % 3600) / 60)}M${sec % 60}S`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${p.title} — edited by ${site.name}`,
    itemListElement: eps.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'VideoObject',
        name: v.title,
        description: `${label(v.id)} · ${s.channel.name}`,
        thumbnailUrl: `https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`,
        uploadDate: v.published,
        duration: isoDuration(v.durationSec),
        embedUrl: `https://www.youtube-nocookie.com/embed/${v.id}`,
        contentUrl: `https://www.youtube.com/watch?v=${v.id}`,
        interactionStatistic: { '@type': 'InteractionCounter', interactionType: { '@type': 'WatchAction' }, userInteractionCount: v.views },
      },
    })),
  },
];
---

<Base title={`${p.title} — ${site.name}, ${site.role}`} description={`${p.summary} ${compact(s.views)} public views across ${s.count} ${s.count === 1 ? 'video' : 'videos'}.`} ogImage={`/og/${p.slug}.jpg`} jsonLd={jsonLd}>
  <article class="case">
    <header class="wrap case__hero">
      <nav class="case__crumbs label" aria-label="Breadcrumb">
        <a class="link" href="/work/">Work</a>
        <span class="dim" aria-hidden="true">/</span>
        <span aria-current="page">Case {String(index + 1).padStart(2, '0')}</span>
      </nav>
      <p class="label muted case__kicker">
        <a class="link" href={s.channel.url} target="_blank" rel="noopener">{s.channel.name}</a> · {p.format}
      </p>
      <h1 class="display case__title">{p.title}</h1>
      <p class="case__sub">
        {p.titleAr && <span lang="ar" dir="rtl" class="case__ar">{p.titleAr}</span>}
        {p.gloss && <span class="label dim">{p.gloss}</span>}
      </p>
      <p class="lead case__lead">{p.summary}</p>

      <dl class="case__stats">
        <div><dt class="label dim">Public views</dt><dd class="display volt">{compact(s.views)}</dd></div>
        <div><dt class="label dim">{s.count === 1 ? 'Video' : 'Videos'}</dt><dd class="display">{s.count}</dd></div>
        <div><dt class="label dim">Top video</dt><dd class="display">{compact(s.top.views)}</dd></div>
        <div><dt class="label dim">Runtime</dt><dd class="case__small">{runtime}</dd></div>
        <div><dt class="label dim">Published</dt><dd class="case__small">{period}</dd></div>
      </dl>
    </header>

    {
      isShorts ? (
        <section class="case__shorts" aria-label="Shorts">
          <ShortsRail />
        </section>
      ) : (
        <section class="wrap case__player" aria-label="Featured episode">
          <p class="label case__now">
            <span class="rec-dot" aria-hidden="true" /> Most watched · {label(s.top.id)}
          </p>
          <YouTubePlayer id={s.top.id} label={label(s.top.id)} group={group} eager priority sizes="(min-width: 1600px) 1500px, 100vw" class="ticks" />
        </section>
      )
    }

    <section class="wrap case__body">
      <div class="case__col">
        <h2 class="label volt">On screen</h2>
        <p class="case__hint muted">What you can see in the published cut.</p>
        <ul role="list" class="case__list">
          {p.onScreen.map((o, i) => <li data-reveal style={`--i:${i}`}><span class="label dim">{String(i + 1).padStart(2, '0')}</span><span>{o}</span></li>)}
        </ul>
      </div>
      <div class="case__col">
        <h2 class="label volt">Case notes</h2>
        <dl class="case__notes">
          <div>
            <dt class="label dim">My role</dt>
            <Text value={p.role} as="dd" />
          </div>
          {
            p.notes.map((n) => (
              <div>
                <dt class="label dim">{n.label}</dt>
                <Text value={n.body} as="dd" />
              </div>
            ))
          }
          <div>
            <dt class="label dim">Result</dt>
            <dd>{compact(s.views)} public views on YouTube across {s.count} {s.count === 1 ? 'video' : 'videos'}; the top one has {compact(s.top.views)}.</dd>
          </div>
        </dl>
      </div>
    </section>

    {
      !isShorts && s.count > 1 && (
        <section class="wrap case__eps" aria-labelledby="eps-title">
          <h2 class="label volt" id="eps-title">All {s.count} videos</h2>
          <ol role="list" class="eps">
            {eps.map((v) => (
              <li class="ep" data-reveal>
                <button
                  type="button"
                  class="ep__btn"
                  data-yt-switch={group}
                  data-yt-id={v.id}
                  data-cursor="Play"
                  aria-pressed={v.id === s.top.id ? 'true' : 'false'}
                >
                  <span class="visually-hidden">Play {label(v.id)} — {compact(v.views)} views</span>
                  <span class="ep__media">
                    <Picture src={thumb(v.id)} widths={[320, 560]} sizes="(min-width: 900px) 22vw, 50vw" formats={['avif', 'webp']} alt="" loading="lazy" />
                    <span class="ep__dur label" aria-hidden="true">{duration(v.durationSec)}</span>
                  </span>
                </button>
                <div class="ep__info">
                  <p class="label ep__label">{label(v.id)}</p>
                  <p class="ep__ar" lang="ar" dir="rtl">{v.title}</p>
                  <p class="label dim">
                    <span class="volt">{compact(v.views)} views</span> · {longDate(v.published)} ·{' '}
                    <a class="link" href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener">
                      YouTube ↗
                    </a>
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      (related.length > 0 || p.related?.beforeAfter) && (
        <section class="wrap case__related" aria-labelledby="rel-title">
          <h2 class="label volt" id="rel-title">Related work</h2>
          <div class="case__relgrid">
            {related.map((m) => <VideoLoop piece={m} />)}
            {p.related?.beforeAfter && (
              <a href="/#before-after" class="rel-ba" data-cursor="View">
                <span class="rel-ba__media">
                  <Picture src={poster('ba-before-poster')} widths={[400]} formats={['avif', 'webp']} alt="" class="rel-ba__a" loading="lazy" />
                  <Picture src={poster('ba-after-poster')} widths={[400]} formats={['avif', 'webp']} alt="" class="rel-ba__b" loading="lazy" />
                </span>
                <span class="rel-ba__t">Before / After</span>
                <span class="muted">A Tornado FPL Short, raw against final. Drag to compare →</span>
              </a>
            )}
          </div>
        </section>
      )
    }

    <section class="wrap case__next" aria-label="Next case study">
      <a href={`/work/${next.slug}/`} class="next" data-cursor="Next" data-track="project_open" data-track-where={next.slug}>
        <span class="label dim">Next case</span>
        <span class="next__t display">{next.title}</span>
        <span class="label muted">{nextStats.channel.name} · {compact(nextStats.views)} views →</span>
        <span class="next__img" aria-hidden="true">
          <Picture src={nextStats.top.kind === 'short' ? thumb(nextStats.top.id, 'tall') : thumb(nextStats.top.id)} widths={[480, 800]} sizes="40vw" formats={['avif', 'webp']} alt="" loading="lazy" />
        </span>
      </a>
      <div class="case__cta">
        <p class="display case__cta-t">Got a show like this?</p>
        <a href="/#contact" class="btn btn--primary" data-track="cta_contact" data-track-where={p.slug}>Send me the footage <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </section>
  </article>
</Base>

<style>
  .case__hero {
    padding-block: var(--s-6) var(--s-7);
    display: grid;
    gap: var(--s-4);
  }
  .case__crumbs {
    display: flex;
    gap: var(--s-2);
    margin-bottom: var(--s-4);
  }
  .case__title {
    font-size: var(--fs-h1);
    font-stretch: 64%;
    max-width: 14ch;
  }
  @media (prefers-reduced-motion: no-preference) {
    .js .case__title {
      animation: case-in 800ms var(--ease-cut) both;
    }
  }
  @keyframes case-in {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(20px);
    }
  }
  .case__sub {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-4);
  }
  .case__ar {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 800;
    color: var(--muted);
  }
  .case__lead {
    max-width: 52ch;
    color: var(--muted);
  }
  .case__stats {
    display: grid;
    grid-template-columns: repeat(5, auto);
    justify-content: start;
    gap: var(--s-4) clamp(1.5rem, 4vw, 4rem);
    border-top: 1px solid var(--line);
    padding-top: var(--s-5);
    margin-top: var(--s-4);
  }
  .case__stats dd.display {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-stretch: 70%;
    line-height: 1;
    margin-top: var(--s-2);
  }
  .case__small {
    margin-top: var(--s-2);
    font-size: var(--fs-small);
  }

  .case__player {
    display: grid;
    gap: var(--s-3);
  }
  .case__now {
    display: flex;
    gap: 0.6em;
    align-items: center;
  }
  .case__shorts {
    padding-top: var(--s-4);
  }

  .case__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: var(--section) 0;
  }
  .case__col {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .case__hint {
    font-size: var(--fs-small);
  }
  .case__list {
    border-top: 1px solid var(--line);
  }
  .case__list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--s-3);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--line);
  }
  .case__notes {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .case__notes > div {
    display: grid;
    gap: var(--s-2);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--line);
  }

  .case__eps {
    padding-top: var(--section);
    display: grid;
    gap: var(--s-5);
  }
  .eps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--s-6) var(--s-5);
  }
  .ep {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .ep__btn {
    display: block;
    width: 100%;
  }
  .ep__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink-3);
  }
  .ep__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-cine) var(--ease-out);
  }
  .ep__btn:hover .ep__media :global(img) {
    transform: scale(1.04);
  }
  .ep__media::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid transparent;
    transition: border-color var(--t-fast);
  }
  .ep__btn[aria-pressed='true'] .ep__media::after {
    border-color: var(--volt);
  }
  .ep__dur {
    position: absolute;
    right: var(--s-2);
    bottom: var(--s-2);
    padding: 0.2em 0.45em;
    background: rgb(10 10 11 / 0.85);
  }
  .ep__info {
    display: grid;
    gap: var(--s-1);
  }
  .ep__label {
    color: var(--paper);
  }
  .ep__ar {
    color: var(--muted);
    font-size: 0.95rem;
    text-align: left;
    line-height: 1.5;
  }

  .case__related {
    padding-top: var(--section);
    display: grid;
    gap: var(--s-5);
  }
  .case__relgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    gap: var(--s-6);
    align-items: start;
  }
  .rel-ba {
    display: grid;
    gap: var(--s-3);
  }
  .rel-ba__media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink-3);
  }
  .rel-ba__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rel-ba__t {
    font-family: var(--font-display);
    font-stretch: 75%;
    font-weight: 750;
    font-size: var(--fs-h4);
    text-transform: uppercase;
  }

  .case__next {
    padding-block: var(--section);
    display: grid;
    gap: var(--s-8);
  }
  .next {
    position: relative;
    display: grid;
    gap: var(--s-3);
    padding-block: var(--s-7);
    border-block: 1px solid var(--line);
    overflow: hidden;
  }
  .next__t {
    font-size: var(--fs-h2);
    font-stretch: 64%;
    position: relative;
    z-index: 1;
    max-width: 62%;
    transition: transform var(--t) var(--ease-out);
  }
  .next:hover .next__t {
    transform: translateX(8px);
  }
  .next__img {
    position: absolute;
    right: 0;
    top: 50%;
    width: min(34%, 28rem);
    transform: translateY(-50%);
    opacity: 0.55;
    transition:
      opacity var(--t) var(--ease-out),
      transform var(--t-cine) var(--ease-out);
  }
  .next__img :global(img) {
    width: 100%;
    max-height: 14rem;
    object-fit: cover;
  }
  .next:hover .next__img {
    opacity: 1;
    transform: translateY(-50%) scale(1.03);
  }
  .case__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-5);
  }
  .case__cta-t {
    font-size: var(--fs-h3);
  }

  @media (max-width: 900px) {
    .case__stats {
      grid-template-columns: repeat(3, auto);
    }
    .case__body {
      grid-template-columns: 1fr;
    }
    .next__img {
      display: none;
    }
    .next__t {
      max-width: none;
    }
  }
  @media (max-width: 480px) {
    .case__stats {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
