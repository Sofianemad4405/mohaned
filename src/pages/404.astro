---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Mohanad Gamal" description="This page doesn’t exist." noindex>
  <section class="wrap nf">
    <p class="label"><span class="rec-dot" aria-hidden="true"></span> <span class="volt">Media offline</span></p>
    <h1 class="display nf__t">This clip<br />isn’t linked.</h1>
    <p class="lead muted">The page you were after has moved or never existed. The work is still here.</p>
    <div class="nf__ctas">
      <a class="btn btn--primary" href="/">Back to the start <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn" href="/work/">All work</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 70vh;
    display: grid;
    align-content: center;
    gap: var(--s-5);
    padding-block: var(--s-9);
  }
  .nf__t {
    font-size: var(--fs-h1);
    font-stretch: 64%;
  }
  .nf__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
</style>
