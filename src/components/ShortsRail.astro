---
import { Picture } from 'astro:assets';
import { getProject, instagramReel } from '../data/projects';
import { getVideo } from '../lib/portfolio';
import { thumb } from '../lib/thumbs';
import { compact, duration } from '../lib/format';

interface Props {
  withReel?: boolean;
}
const { withReel = true } = Astro.props;
const shorts = getProject('shorts')!;
const items = [...shorts.episodes].map(getVideo).sort((a, b) => b.views - a.views);
---

<div class="rail" data-rail>
  <ul class="rail__track" role="list" data-rail-track>
    {
      items.map((v) => {
        const label = shorts.episodeLabels?.[v.id] ?? '';
        return (
          <li class="rail__item">
            <button
              type="button"
              class="rail__card"
              data-modal-yt={v.id}
              data-modal-orient="tall"
              data-modal-label={label}
              data-cursor="Play"
              data-track="video_play"
              data-track-where={v.id}
            >
              <span class="visually-hidden">Play Short: {label} — {compact(v.views)} views</span>
              <span class="rail__media">
                <Picture src={thumb(v.id, 'tall')} widths={[240, 360, 480]} sizes="(min-width: 900px) 15rem, 55vw" formats={['avif', 'webp']} alt="" loading="lazy" />
                <span class="rail__views label" aria-hidden="true">{compact(v.views)} views</span>
                <span class="rail__dur label" aria-hidden="true">{duration(v.durationSec)}</span>
              </span>
            </button>
            <p class="rail__label label">{label}</p>
            <p class="rail__ar" lang="ar" dir="rtl">{v.title}</p>
          </li>
        );
      })
    }
    {
      withReel && (
        <li class="rail__item">
          <a class="rail__card" href={instagramReel.url} target="_blank" rel="noopener" data-cursor="Open" data-track="video_external" data-track-where="instagram">
            <span class="visually-hidden">Instagram reel for {instagramReel.creator} — opens Instagram</span>
            <span class="rail__media">
              <Picture src={thumb(instagramReel.id, 'tall')} widths={[240, 360, 480]} sizes="(min-width: 900px) 15rem, 55vw" formats={['avif', 'webp']} alt="" loading="lazy" />
              <span class="rail__views label" aria-hidden="true">Instagram ↗</span>
            </span>
          </a>
          <p class="rail__label label">Reel · {instagramReel.creator}</p>
          <p class="rail__ar label dim">{compact(instagramReel.likes)} likes</p>
        </li>
      )
    }
  </ul>
  <div class="rail__nav" aria-hidden="true">
    <button type="button" class="rail__arrow" data-rail-prev tabindex="-1">←</button>
    <button type="button" class="rail__arrow" data-rail-next tabindex="-1">→</button>
  </div>
</div>

<style>
  .rail {
    position: relative;
  }
  .rail__track {
    display: flex;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding-inline: var(--gutter);
    padding-bottom: var(--s-4);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .rail__track::-webkit-scrollbar {
    display: none;
  }
  .rail__item {
    flex: 0 0 clamp(11.5rem, 52vw, 15rem);
    scroll-snap-align: start;
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }
  .rail__card {
    /* Containing block for the visually-hidden label, so it stays inside the scroller */
    position: relative;
    display: block;
    width: 100%;
    text-align: left;
  }
  .rail__card:focus-visible {
    outline-offset: 3px;
  }
  .rail__media {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background: var(--ink-3);
  }
  .rail__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform var(--t-cine) var(--ease-out),
      filter var(--t) var(--ease-out);
  }
  .rail__card:hover .rail__media :global(img) {
    transform: scale(1.04);
  }
  .rail__views,
  .rail__dur {
    position: absolute;
    bottom: var(--s-2);
    padding: 0.25em 0.5em;
    background: rgb(10 10 11 / 0.8);
    font-variant-numeric: tabular-nums;
  }
  .rail__views {
    left: var(--s-2);
    color: var(--volt);
  }
  .rail__dur {
    right: var(--s-2);
  }
  .rail__label {
    margin-top: var(--s-1);
    color: var(--paper);
  }
  .rail__ar {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
    text-align: left;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .rail__nav {
    display: flex;
    gap: var(--s-2);
    justify-content: flex-end;
    padding-inline: var(--gutter);
    margin-top: var(--s-3);
  }
  .rail__arrow {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    font-size: 1.1rem;
    transition:
      background-color var(--t-fast),
      color var(--t-fast),
      opacity var(--t-fast);
  }
  .rail__arrow:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .rail__arrow:disabled {
    opacity: 0.3;
    pointer-events: none;
  }
  @media (hover: none) {
    .rail__nav {
      display: none;
    }
  }
  @media (min-width: 1600px) {
    .rail__track {
      padding-inline: calc((100vw - var(--max)) / 2 + var(--gutter));
      scroll-padding-inline: calc((100vw - var(--max)) / 2 + var(--gutter));
    }
  }
</style>
