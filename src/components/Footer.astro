---
import { site } from '../data/site';
import { gmailCompose } from '../lib/media';

const year = new Date().getFullYear();
const { credit } = site;
const icons: Record<string, string> = {
  whatsapp:
    'M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 01-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 00-.7.3 3 3 0 00-.9 2.2 5.2 5.2 0 001.1 2.7 11.8 11.8 0 004.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 001.8-1.2 2.2 2.2 0 00.1-1.2c0-.1-.2-.2-.5-.3z',
  x: 'M17.8 3h3l-6.6 7.6L22 21h-6.1l-4.8-6.3L5.6 21h-3l7.1-8.1L2.2 3h6.2l4.3 5.7L17.8 3zm-1 16.2h1.7L7.3 4.7H5.5l11.3 14.5z',
  instagram:
    'M12 7a5 5 0 100 10 5 5 0 000-10zm0 8.2a3.2 3.2 0 110-6.4 3.2 3.2 0 010 6.4zM17.2 5.6a1.2 1.2 0 100 2.4 1.2 1.2 0 000-2.4zM12 3.8c2.7 0 3 0 4 .1 2.7.1 4 1.4 4.1 4.1.1 1 .1 1.3.1 4s0 3-.1 4c-.1 2.7-1.4 4-4.1 4.1-1 .1-1.3.1-4 .1s-3 0-4-.1c-2.7-.1-4-1.4-4.1-4.1-.1-1-.1-1.3-.1-4s0-3 .1-4C4 5.3 5.3 4 8 3.9c1-.1 1.3-.1 4-.1zM12 2c-2.7 0-3.1 0-4.1.1C4.2 2.3 2.3 4.2 2.1 7.9 2 8.9 2 9.3 2 12s0 3.1.1 4.1c.2 3.7 2.1 5.6 5.8 5.8 1 .1 1.4.1 4.1.1s3.1 0 4.1-.1c3.7-.2 5.6-2.1 5.8-5.8.1-1 .1-1.4.1-4.1s0-3.1-.1-4.1c-.2-3.7-2.1-5.6-5.8-5.8C15.1 2 14.7 2 12 2z',
};
---

<footer class="foot">
  <div class="wrap foot__grid">
    <div class="foot__id">
      <p class="display foot__name">{site.name}</p>
      <p class="label muted">{site.position.title} · {site.position.company}</p>
      <p class="label muted">{site.location}</p>
    </div>

    <nav class="foot__col" aria-label="Footer">
      <p class="label dim">Index</p>
      <ul role="list">
        <li><a class="link" href="/work/">All work</a></li>
        <li><a class="link" href="/#before-after">Before / After</a></li>
        <li><a class="link" href="/#motion">Motion</a></li>
        <li><a class="link" href="/#about">About</a></li>
        <li><a class="link" href="/#contact">Contact</a></li>
      </ul>
    </nav>

    <div class="foot__col">
      <p class="label dim">Contact</p>
      <ul role="list">
        <li><a class="link" href={gmailCompose(site.contact.email)} target="_blank" rel="noopener" data-track="cta_email" data-track-where="footer">{site.contact.email}</a></li>
        {
          site.socials
            .filter((s) => s.href)
            .map((s) => (
              <li>
                <a class="link" href={s.href} rel="me noopener" target="_blank" data-track="social" data-track-where={s.label}>
                  {s.label} ↗
                </a>
              </li>
            ))
        }
      </ul>
    </div>
  </div>

  <div class="wrap foot__base label dim">
    <p>© {year} {site.name}</p>
    <div class="credit">
      <p class="credit__by">
        <span>Designed &amp; built by</span>
        <a class="credit__name" href={credit.links[0].href} target="_blank" rel="noopener" data-track="credit" data-track-where="name">{credit.name}</a>
        <span class="credit__role">{credit.role}</span>
      </p>
      <ul role="list" class="credit__links">
        {
          credit.links.map((l) => (
            <li>
              <a class="credit__icon" href={l.href} target="_blank" rel="noopener" aria-label={`${credit.name} on ${l.label}`} data-track="credit" data-track-where={l.kind}>
                <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d={icons[l.kind]} fill="currentColor" /></svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <a class="link foot__top" href="#main">Back to top ↑</a>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
    padding-block: var(--s-8) var(--s-6);
  }
  .foot__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.3fr;
    gap: var(--s-7);
  }
  .foot__name {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin-bottom: var(--s-3);
  }
  .foot__id {
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }
  .foot__col {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .foot__col ul {
    display: grid;
    gap: var(--s-2);
    font-size: var(--fs-small);
  }
  .foot__col a {
    display: inline-block;
    padding-block: 0.2rem;
  }
  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
  .foot__base {
    align-items: center;
  }
  .foot__top {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .credit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }
  .credit__by {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25em 0.6em;
  }
  .credit__name {
    color: var(--paper);
    font-weight: 700;
    letter-spacing: 0.04em;
    background: linear-gradient(var(--volt), var(--volt)) 0 100% / 0 1px no-repeat;
    transition:
      background-size var(--t) var(--ease-out),
      color var(--t-fast);
  }
  .credit__name:hover {
    color: var(--volt);
    background-size: 100% 1px;
  }
  .credit__role {
    padding: 0.2em 0.55em;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    color: var(--muted);
  }
  .credit__links {
    display: flex;
    gap: var(--s-2);
  }
  .credit__icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--muted);
    transition:
      background-color var(--t-fast),
      color var(--t-fast),
      border-color var(--t-fast),
      transform var(--t-fast) var(--ease-out);
  }
  .credit__icon:hover {
    background: var(--volt);
    border-color: var(--volt);
    color: var(--volt-ink);
    transform: translateY(-2px);
  }
  @media (max-width: 760px) {
    .foot__grid {
      grid-template-columns: 1fr 1fr;
    }
    .foot__id {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 420px) {
    .foot__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
