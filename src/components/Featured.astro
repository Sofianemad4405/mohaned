---
import { Picture } from 'astro:assets';
import { ARTIFACT, pic, ytOut } from '../lib/env';
import type { Project } from '../data/types';
import { getVideo, projectStats } from '../lib/portfolio';
import { thumb } from '../lib/thumbs';
import { compact, durationWords, monthYear } from '../lib/format';
import YouTubePlayer from './YouTubePlayer.astro';

interface Props {
  project: Project;
  index: number;
}
const { project: p, index } = Astro.props;
const s = projectStats(p);
const group = `feat-${p.slug}`;
const Ep = ARTIFACT ? 'a' : 'button';
---

<article class="feat" aria-labelledby={`feat-${p.slug}`}>
  <div class="feat__player" data-reveal="wipe">
    <YouTubePlayer id={s.top.id} label={p.episodeLabels?.[s.top.id] ?? p.title} group={group} eager sizes="(min-width: 1100px) 62vw, 100vw" class="ticks" />
  </div>

  <div class="feat__info">
    <p class="label" data-reveal><span class="volt">0{index} · Most watched</span> <span class="dim">·</span> <span class="muted">{s.channel.name} · {p.format}</span></p>
    <h3 class="feat__title display" id={`feat-${p.slug}`} data-reveal style="--i:1">
      {p.title}
      {p.gloss && <span class="feat__gloss">{p.gloss}</span>}
    </h3>
    {p.titleAr && <p class="feat__ar" lang="ar" dir="rtl" data-reveal style="--i:2">{p.titleAr}</p>}
    <p class="feat__sum" data-reveal style="--i:3">{p.summary}</p>

    <dl class="feat__stats" data-reveal style="--i:4">
      <div><dt class="label dim">Views</dt><dd class="display">{compact(s.views)}</dd></div>
      <div><dt class="label dim">Episodes</dt><dd class="display">{s.count}</dd></div>
      <div><dt class="label dim">Top episode</dt><dd class="display volt">{compact(s.top.views)}</dd></div>
    </dl>

    <div class="feat__eps" data-reveal style="--i:5">
      <p class="label dim" id={`${group}-eps`}>{ARTIFACT ? 'Episodes on YouTube' : 'Play an episode'}</p>
      <ul role="list" class="feat__strip" aria-labelledby={`${group}-eps`}>
        {
          p.episodes.map((id) => {
            const v = getVideo(id);
            const label = p.episodeLabels?.[id] ?? v.title;
            return (
              <li>
                <Ep
                  class="feat__ep"
                  {...(ARTIFACT
                    ? ytOut(id, v.kind)
                    : { type: 'button' as const, 'data-yt-switch': group, 'data-yt-id': id, 'aria-pressed': id === s.top.id ? 'true' : 'false' })}
                >
                  <span class="visually-hidden">Play {label} — {compact(v.views)} views, {durationWords(v.durationSec)}, {monthYear(v.published)}</span>
                  <Picture src={thumb(id)} {...pic([240, 360])} sizes="120px" alt="" loading="lazy" />
                  <span class="feat__ep-l label" aria-hidden="true">{label.replace('S3 · ', '')}</span>
                </Ep>
              </li>
            );
          })
        }
      </ul>
    </div>

  </div>
</article>

<style>
  .feat {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }
  .feat__info {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .feat__title {
    font-size: clamp(2.75rem, 5.5vw, 5.25rem);
    font-stretch: 66%;
  }
  .feat__gloss {
    display: block;
    font-size: 0.42em;
    font-stretch: 80%;
    color: var(--muted);
    margin-top: 0.25em;
  }
  .feat__ar {
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 800;
    color: var(--muted);
    text-align: left;
    line-height: 1.3;
  }
  .feat__sum {
    color: var(--muted);
    max-width: 44ch;
  }
  .feat__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-block: 1px solid var(--line);
    padding-block: var(--s-4);
  }
  .feat__stats div + div {
    border-left: 1px solid var(--line);
    padding-left: var(--s-4);
  }
  .feat__stats dd {
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-stretch: 70%;
    line-height: 1;
    margin-top: var(--s-1);
  }
  .feat__eps {
    display: grid;
    gap: var(--s-2);
  }
  .feat__strip {
    display: flex;
    gap: var(--s-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--s-2);
    scrollbar-width: thin;
    scrollbar-color: var(--ink-4) transparent;
  }
  .feat__strip li {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }
  .feat__ep {
    position: relative;
    display: block;
    width: 7.5rem;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink-3);
    outline-offset: 2px;
  }
  .feat__ep :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
    filter: grayscale(0.6);
    transition:
      opacity var(--t) var(--ease-out),
      filter var(--t) var(--ease-out);
  }
  .feat__ep:hover :global(img),
  .feat__ep[aria-pressed='true'] :global(img) {
    opacity: 1;
    filter: none;
  }
  .feat__ep::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid transparent;
    transition: border-color var(--t-fast);
  }
  .feat__ep[aria-pressed='true']::after {
    border-color: var(--volt);
  }
  .feat__ep-l {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.2em 0.45em;
    background: rgb(10 10 11 / 0.85);
    font-size: 0.625rem;
  }
  @media (max-width: 1100px) {
    .feat {
      grid-template-columns: 1fr;
    }
  }
</style>
