---
import { site } from '../data/site';
import { channels } from '../data/channels';
import { services } from '../data/services';
import { compact } from '../lib/format';
import SectionHead from './SectionHead.astro';
import Text from './Text.astro';
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <SectionHead id="about" tc="00:04:10:00" kicker="About" title="The edit is <em>the show.</em>" />

    <div class="about__grid">
      <div class="about__bio">
        {site.bio.map((para, i) => <Text value={para} as="p" class={i === 0 ? 'about__lead' : 'about__p'} />)}
      </div>

      <dl class="about__facts">
        <div>
          <dt class="label dim">Cutting for</dt>
          <dd>
            <ul role="list" class="about__channels">
              {
                Object.values(channels).map((c) => (
                  <li>
                    <a class="link" href={c.url} target="_blank" rel="noopener">
                      {c.name}
                    </a>{' '}
                    <span class="dim label">{compact(c.subscribers)} subscribers</span>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
        <div>
          <dt class="label dim">Based in</dt>
          <Text value={site.location} as="dd" />
        </div>
        <div>
          <dt class="label dim">Tools</dt>
          {site.tools.length ? <dd>{site.tools.join(' · ')}</dd> : <Text value={site.toolsPlaceholder} as="dd" />}
        </div>
        <div>
          <dt class="label dim">Availability</dt>
          <Text value={site.availability} as="dd" />
        </div>
      </dl>
    </div>

    <div class="services" id="services">
      <h3 class="label services__head"><span class="volt">What I do</span> <span class="dim">— each backed by work on this page</span></h3>
      <ol role="list" class="services__list">
        {
          services.map((s, i) => (
            <li class="svc" data-reveal style={`--i:${i % 3}`}>
              <span class="svc__n label">{String(i + 1).padStart(2, '0')}</span>
              <h4 class="svc__t">{s.title}</h4>
              <p class="svc__b">{s.body}</p>
              <p class="svc__e label">
                {s.evidence.map((e, j) => (
                  <>
                    {j > 0 && <span class="dim"> · </span>}
                    <a class="link" href={e.href}>
                      {e.label} →
                    </a>
                  </>
                ))}
              </p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="brands" aria-labelledby="brands-title">
      <h3 class="label dim" id="brands-title">Brands I’ve worked with</h3>
      <ul role="list" class="brands__list">
        {site.brands.map((b, i) => <li class="display" data-reveal style={`--i:${i}`}>{b}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
  }
  .about__bio {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }
  .about__bio :global(.about__lead) {
    font-size: clamp(1.375rem, 2.3vw, 2rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 30ch;
  }
  .about__bio :global(.about__p) {
    color: var(--muted);
    max-width: 52ch;
  }
  .about__facts {
    display: grid;
    gap: var(--s-5);
    align-content: start;
    border-top: 1px solid var(--line);
    padding-top: var(--s-5);
  }
  .about__facts > div {
    display: grid;
    gap: var(--s-2);
  }
  .about__channels {
    display: grid;
    gap: var(--s-1);
  }

  .services {
    margin-top: var(--section);
  }
  .services__head {
    margin-bottom: var(--s-6);
  }
  .services__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .svc {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding: var(--s-6) var(--s-5) var(--s-6) 0;
    border-bottom: 1px solid var(--line);
  }
  .svc:not(:nth-child(3n + 1)) {
    padding-left: var(--s-5);
    border-left: 1px solid var(--line);
  }
  .svc__n {
    color: var(--volt);
  }
  .svc__t {
    font-family: var(--font-display);
    font-stretch: 72%;
    font-weight: 800;
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    text-transform: uppercase;
    line-height: 1;
  }
  .svc__b {
    color: var(--muted);
    font-size: var(--fs-small);
    max-width: 38ch;
  }
  .svc__e {
    margin-top: var(--s-2);
  }

  .brands {
    margin-top: var(--section);
    display: grid;
    gap: var(--s-5);
  }
  .brands__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(1.5rem, 4vw, 4rem);
    border-block: 1px solid var(--line);
    padding-block: var(--s-6);
  }
  .brands__list li {
    font-size: clamp(2.5rem, 7vw, 6.5rem);
    font-stretch: 62%;
    line-height: 1;
    color: var(--paper);
    transition: color var(--t) var(--ease-out);
  }
  .brands__list:hover li {
    color: var(--dim);
  }
  .brands__list li:hover {
    color: var(--volt);
  }

  @media (max-width: 960px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .services__list {
      grid-template-columns: 1fr 1fr;
    }
    .svc:not(:nth-child(3n + 1)) {
      padding-left: 0;
      border-left: 0;
    }
    .svc:nth-child(2n) {
      padding-left: var(--s-5);
      border-left: 1px solid var(--line);
    }
  }
  @media (max-width: 600px) {
    .services__list {
      grid-template-columns: 1fr;
    }
    .svc:nth-child(2n) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
