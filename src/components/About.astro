---
import { site } from '../data/site';
import { channels } from '../data/channels';
import { services } from '../data/services';
import { brands } from '../data/brands';
import { compact } from '../lib/format';
import { Picture } from 'astro:assets';
import { pic } from '../lib/env';
import { poster } from '../lib/posters';
import SectionHead from './SectionHead.astro';
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <SectionHead id="about" tc="00:04:10:00" kicker="About" title="The edit is <em>the show.</em>" />

    <div class="about__grid">
      <figure class="about__portrait ticks" data-reveal>
        <Picture src={poster('mohanad-portrait')} {...pic([480, 800])} sizes="(min-width: 960px) 30vw, 100vw" alt={`${site.name}`} loading="lazy" />
        <figcaption class="label">
          <span class="rec-dot" aria-hidden="true"></span> {site.name} <span class="dim">· {site.location}</span>
        </figcaption>
      </figure>
      <div class="about__main">
      <div class="about__bio">
        <p class="about__lead">{site.bio}</p>
        <p class="about__p">{site.about}</p>
      </div>

      <dl class="about__facts">
        <div>
          <dt class="label dim">Now</dt>
          <dd>{site.position.title} at {site.position.company}</dd>
        </div>
        <div>
          <dt class="label dim">Editing for</dt>
          <dd>
            <ul role="list" class="about__channels">
              {
                Object.values(channels).map((c) => (
                  <li>
                    <a class="link" href={c.url} target="_blank" rel="noopener">
                      {c.name}
                    </a>{' '}
                    <span class="dim label">{compact(c.subscribers)} subscribers</span>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
        <div>
          <dt class="label dim">Tools</dt>
          <dd>{site.tools.join(' · ')}</dd>
        </div>
        <div>
          <dt class="label dim">Based in</dt>
          <dd>{site.location}</dd>
        </div>
        <div>
          <dt class="label dim">Availability</dt>
          <dd class="about__avail"><span class="about__dot" aria-hidden="true"></span>{site.availability}</dd>
        </div>
      </dl>
      </div>
    </div>

    <div class="services" id="services">
      <h3 class="label services__head"><span class="volt">What I do</span></h3>
      <ol role="list" class="services__list">
        {
          services.map((s, i) => (
            <li class="svc" data-reveal style={`--i:${i}`}>
              <span class="svc__n label">{String(i + 1).padStart(2, '0')}</span>
              <h4 class="svc__t">{s.title}</h4>
              <p class="svc__b">{s.body}</p>
              <p class="svc__e label">
                {s.evidence.map((e, j) => (
                  <>
                    {j > 0 && <span class="dim"> · </span>}
                    <a class="link" href={e.href}>
                      {e.label} →
                    </a>
                  </>
                ))}
              </p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="brands" aria-labelledby="brands-title">
      <h3 class="label dim" id="brands-title">Brands I’ve worked with <span class="volt">· {brands.length}</span></h3>
      <ul role="list" class="brands__board">
        {
          brands.map((b, i) => (
            <li class="brand" data-reveal style={`--i:${i % 7};--h:${b.h ?? 34}`}>
              {b.logo ? (
                <img src={b.logo.src} alt={b.name} width={b.logo.width} height={b.logo.height} loading="lazy" decoding="async" />
              ) : (
                <span class="brand__word">{b.name}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.6fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .about__portrait {
    position: relative;
    display: grid;
    gap: var(--s-3);
  }
  .about__portrait :global(img) {
    width: 100%;
    aspect-ratio: 885 / 1051;
    object-fit: cover;
    background: var(--ink-3);
  }
  .about__portrait figcaption {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .about__main {
    display: grid;
    gap: var(--s-7);
  }
  .about__bio {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }
  .about__lead {
    font-family: var(--font-display);
    font-stretch: 66%;
    font-weight: 800;
    font-size: clamp(2.5rem, 5.5vw, 4.75rem);
    line-height: 0.95;
    text-transform: uppercase;
    text-wrap: balance;
    max-width: 14ch;
  }
  .about__p {
    color: var(--muted);
    max-width: 52ch;
  }
  .about__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5) var(--s-6);
    align-content: start;
    border-top: 1px solid var(--line);
    padding-top: var(--s-5);
  }
  .about__facts > div {
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }
  .about__channels {
    display: grid;
    gap: var(--s-1);
  }
  .about__avail {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    color: var(--volt);
  }
  .about__dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--volt);
    box-shadow: 0 0 0 4px var(--volt-soft);
  }

  .services {
    margin-top: var(--section);
  }
  .services__head {
    margin-bottom: var(--s-6);
  }
  .services__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .svc {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding: var(--s-6) var(--s-5) var(--s-6) 0;
    border-bottom: 1px solid var(--line);
  }
  .svc + .svc {
    padding-left: var(--s-5);
    border-left: 1px solid var(--line);
  }
  .svc__n {
    color: var(--volt);
  }
  .svc__t {
    font-family: var(--font-display);
    font-stretch: 72%;
    font-weight: 800;
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    text-transform: uppercase;
    line-height: 1;
  }
  .svc__b {
    color: var(--muted);
    font-size: var(--fs-small);
    max-width: 38ch;
  }
  .svc__e {
    margin-top: var(--s-2);
  }

  /* Sponsor board: each logo on its own panel, in the brand's own colours */
  .brands {
    margin-top: var(--section);
    display: grid;
    gap: var(--s-5);
  }
  .brands__board {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .brand {
    min-width: 0; /* let the logo shrink instead of widening the grid */
    display: grid;
    place-items: center;
    --tile-h: 0.75; /* height ÷ width */
    aspect-ratio: 1 / var(--tile-h);
    container-type: inline-size;
    padding: var(--s-3);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--ink-2);
    transition: background-color var(--t) var(--ease-out);
  }
  .brand img {
    width: auto;
    height: auto;
    max-width: 72%;
    /* --h is a share of the tile height (= --tile-h × tile width) */
    max-height: calc(var(--h) * var(--tile-h) * 1cqw);
    min-width: 0;
    object-fit: contain;
    opacity: 0.86;
    transition:
      opacity var(--t) var(--ease-out),
      transform var(--t) var(--ease-out);
  }
  .brand__word {
    font-family: var(--font-display);
    font-stretch: 72%;
    font-weight: 800;
    font-size: clamp(1rem, 1.7vw, 1.6rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color var(--t) var(--ease-out);
  }
  .brand:hover {
    background: var(--ink-3);
  }
  .brand:hover img {
    opacity: 1;
    transform: scale(1.05);
  }
  .brand:hover .brand__word {
    color: var(--paper);
  }

  @media (min-width: 761px) and (max-width: 1100px) {
    .brand {
      --tile-h: 1;
    }
  }
  @media (max-width: 960px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__portrait {
      max-width: 24rem;
    }
  }
  @media (max-width: 520px) {
    .about__facts {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 900px) {
    .services__list {
      grid-template-columns: 1fr;
    }
    .svc + .svc {
      padding-left: 0;
      border-left: 0;
    }
  }
  /* Tablets: each service is one row, name on the left, detail on the right */
  @media (min-width: 601px) and (max-width: 900px) {
    .svc {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      column-gap: var(--s-6);
      padding-right: 0;
    }
    .svc__n,
    .svc__t {
      grid-column: 1;
    }
    .svc__b {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: end;
      max-width: none;
    }
    .svc__e {
      grid-column: 2;
      margin-top: 0;
    }
  }
  @media (max-width: 760px) {
    .brands__board {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
