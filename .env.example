# Production URL — used for canonical links, Open Graph and the sitemap.
SITE_URL=https://your-domain.com

# Optional: move /public/media to a CDN (R2, S3, Bunny…) and point here.
# PUBLIC_MEDIA_BASE_URL=https://cdn.your-domain.com/media

# Optional: contact form endpoint that accepts JSON POSTs (Formspree, Web3Forms,
# Basin, a Cloudflare Worker…). Without it the form hands off to the visitor's
# email app with everything pre-filled.
# PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxx
